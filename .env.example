# Copie para .env (nunca versionado) e ajuste. Os valores abaixo servem só para desenvolvimento local;
# em produção, segredos vêm do gestor de segredos do orquestrador.

# Banco (docker-compose) -------------------------------------------------------------------------
POSTGRES_PASSWORD=dev_only_owner
API_DB_PASSWORD=dev_only_api
ETL_DB_PASSWORD=dev_only_etl
MAINT_DB_PASSWORD=dev_only_maint
DB_PORT=5433
API_PORT=8000

# API -------------------------------------------------------------------------------------------
# AGROCREDIT_DATABASE_URL=postgresql://agrocredit_api:<senha>@<host>:5432/agrocredit_db
# AGROCREDIT_POOL_MIN_SIZE=5
# AGROCREDIT_POOL_MAX_SIZE=20
# AGROCREDIT_STATEMENT_TIMEOUT_MS=3000

# Pseudonimização do documento na auditoria (mínimo 32 caracteres). Rotação: RUNBOOK §4.2
AGROCREDIT_HMAC_PEPPER=dev_only_pepper_nao_usar_em_producao_0123456789
# AGROCREDIT_HMAC_KEY_VERSION=1
# AGROCREDIT_HMAC_PEPPERS_ANTERIORES={"1": "<pepper anterior>"}

# JWT: informe exatamente uma origem de chaves públicas
# AGROCREDIT_JWT_JWKS_URL=https://<provedor-de-identidade>/.well-known/jwks.json
# AGROCREDIT_JWT_JWKS_ARQUIVO=/run/secrets/jwks.json
# AGROCREDIT_JWT_JWKS={"keys": [...]}
AGROCREDIT_JWT_ISSUER=https://auth.agrocredit.local
AGROCREDIT_JWT_AUDIENCE=agrocredit-api
# AGROCREDIT_JWT_TENANT_CLAIM=tenant_id

# /metrics: se definido, exige Authorization: Bearer <token>
# AGROCREDIT_METRICS_TOKEN=

# Pipeline e manutenção -------------------------------------------------------------------------
# ETL_DATABASE_URL=postgresql://agrocredit_etl:<senha>@<host>:5432/agrocredit_db
# MAINT_DATABASE_URL=postgresql://agrocredit_maint:<senha>@<host>:5432/agrocredit_db
# MIGRATIONS_DATABASE_URL=postgresql://agrocredit_owner:<senha>@<host>:5432/agrocredit_db
# AGROCREDIT_DATA=data
# AGROCREDIT_ALERTA_CMD=<comando que recebe a mensagem de falha pela entrada padrão>
